# Copy to .env for local development, or set these in the Netlify UI
# (Site configuration → Environment variables) for a deployment.

# The shared secret every /api call must present as `Authorization: Bearer …`.
# The web client asks for it once and keeps it in the browser.
# Generate one with:  openssl rand -base64 32
# Leave it unset locally and the API is open; leave it unset on a deployment
# and the API refuses to serve at all, rather than exposing a writable database.
TRACKER_API_KEY=

# Where the SQLite database lives.
# Unset locally, it falls back to the file ./data/tracker.db.
# On Netlify this must be a hosted libSQL database, because a function's
# filesystem is thrown away between invocations.
#   turso db create trackday && turso db show trackday --url
TURSO_DATABASE_URL=
#   turso db tokens create trackday
TURSO_AUTH_TOKEN=

# Which garage the rows belong to. Only worth changing if you want two
# separate logs in one database.
GARAGE_ID=default
