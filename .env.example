# Copy to .env for local development, or set these on the host for a
# deployment — Vercel: Project Settings → Environment Variables; Netlify:
# Site configuration → Environment variables.

# Where the SQLite database lives.
# Unset locally, it falls back to the file ./data/tracker.db.
# On a deployment this must be a hosted libSQL database — same engine, same
# SQL — because a serverless function's filesystem is read-only and is thrown
# away between invocations.
#   turso db create trackday && turso db show trackday --url
TURSO_DATABASE_URL=
#   turso db tokens create trackday
TURSO_AUTH_TOKEN=

# That is the whole list. Riders sign themselves up, and who may read a
# garage is decided by who is signed in — there is no shared secret to set.
