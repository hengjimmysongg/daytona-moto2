# Optional. The app ships with the project's own Supabase URL and publishable
# key compiled in, so nothing here is needed to run or deploy it.
#
# Set these to point a fork at a different Supabase project. Both are public
# values — the publishable key identifies the project to a browser and grants
# nothing on its own; row-level security decides what a signed-in rider may
# read and write.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
